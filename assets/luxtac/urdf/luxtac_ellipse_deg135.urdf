<?xml version="1.0"?>
<!-- ellipse, long axis at 135 deg in the pad plane.
     Generated by scripts/make_luxtac_objs.py. Metres, centred on x,y, cross-section
     centre at z = 0.0452 (the pad centre once staged). Long axis at 135 deg in
     the x-z plane: 0 = along the finger, 90 = across it. Length 40mm,
     mass 1.500000 kg.

     The link is named 'cube' because TacSL resolves the indenter link by name. -->
<robot name="luxtac_ellipse_deg135">
    <link name="cube">
        <visual>
            <geometry><mesh filename="../mesh/luxtac_ellipse_deg135.obj"/></geometry>
            <material name="black"><color rgba="0.05 0.05 0.05 1"/></material>
        </visual>
        <collision>
            <geometry><mesh filename="../mesh/luxtac_ellipse_deg135.obj"/></geometry>
            <sdf resolution="256"/>  <!-- 0.221mm voxels -->
        </collision>
        <inertial>
            <origin rpy="0 0 0" xyz="0 0 0.0452"/>
            <mass value="1.500000"/>
            <inertia ixx="2.124197e-04" ixy="0" ixz="0" iyy="3.498929e-04" iyz="0" izz="2.124197e-04"/>
        </inertial>
    </link>
</robot>
