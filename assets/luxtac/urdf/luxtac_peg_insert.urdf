<?xml version="1.0"?>
<!-- peg, 90mm long, for insertion teleop.
     Generated by scripts/make_luxtac_objs.py. Metres, centred on x,y, cross-section
     centre at z = 0.0452 (the pad centre once staged). Long axis at 0 deg in
     the x-z plane: 0 = along the finger, 90 = across it. Length 90mm,
     mass 1.500000 kg.

     The link is named 'cube' because TacSL resolves the indenter link by name. -->
<robot name="luxtac_peg_insert">
    <link name="cube">
        <visual>
            <geometry><mesh filename="../mesh/luxtac_peg_insert.obj"/></geometry>
            <material name="black"><color rgba="0.05 0.05 0.05 1"/></material>
        </visual>
        <collision>
            <geometry><mesh filename="../mesh/luxtac_peg_insert.obj"/></geometry>
            <sdf resolution="256"/>  <!-- 0.352mm voxels -->
        </collision>
        <inertial>
            <origin rpy="0 0 0" xyz="0 0 0.0452"/>
            <mass value="1.500000"/>
            <inertia ixx="1.033579e-03" ixy="0" ixz="0" iyy="1.033579e-03" iyz="0" izz="4.215739e-05"/>
        </inertial>
    </link>
</robot>
